-- Environment variables. See https://wiki.hyprland.org/Configuring/Environment-variables/

-- Set your defaults editor through ENV in ~/.config/hypr/UserConfigs/01-UserDefaults.conf

local env = {}

-- environment-variables
-- Current Version of JakooLit Dotfiles:
env[#env + 1] = { key = "DOTS_VERSION", value = "2.3.20" }

--- Toolkit Backend Variables ---
env[#env + 1] = { key = "GDK_BACKEND", value = "wayland,x11,*" }
env[#env + 1] = { key = "QT_QPA_PLATFORM", value = "wayland;xcb" }
env[#env + 1] = { key = "CLUTTER_BACKEND", value = "wayland" }

-- Run SDL2 applications on Wayland.
-- Remove or set to x11 if games that provide older versions of SDL cause compatibility issues
-- env[#env + 1] = { key = "SDL_VIDEODRIVER", value = "wayland", enabled = false }

--- XDG Specifications ---
env[#env + 1] = { key = "XDG_CURRENT_DESKTOP", value = "Hyprland" }
env[#env + 1] = { key = "XDG_SESSION_DESKTOP", value = "Hyprland" }
env[#env + 1] = { key = "XDG_SESSION_TYPE", value = "wayland" }

--- QT Variables ---
env[#env + 1] = { key = "QT_AUTO_SCREEN_SCALE_FACTOR", value = "1" }
env[#env + 1] = { key = "QT_WAYLAND_DISABLE_WINDOWDECORATION", value = "1" }
env[#env + 1] = { key = "QT_QPA_PLATFORMTHEME", value = "qt5ct" }
env[#env + 1] = { key = "QT_QPA_PLATFORMTHEME", value = "qt6ct" }

--- hyprland-qt-support ---
env[#env + 1] = { key = "QT_QUICK_CONTROLS_STYLE", value = "org.hyprland.style" }

--- xwayland apps scale fix (useful if you are use monitor scaling) ---
-- Set same value if you use scaling in Monitors.conf
-- 1 is 100% 1.5 is 150%
-- see https://wiki.hyprland.org/Configuring/XWayland/
env[#env + 1] = { key = "GDK_SCALE", value = "1" }
env[#env + 1] = { key = "QT_SCALE_FACTOR", value = "1" }

-- Bibata-Modern-Ice-Cursor
-- NOTE! You must have the hyprcursor version to activate this.
-- https://wiki.hyprland.org/Hypr-Ecosystem/hyprcursor/
env[#env + 1] = { key = "HYPRCURSOR_THEME", value = "Bibata-Modern-Ice" }
env[#env + 1] = { key = "HYPRCURSOR_SIZE", value = "24" }

--- firefox ---
env[#env + 1] = { key = "MOZ_ENABLE_WAYLAND", value = "1" }

--- electron >28 apps (may help) ---
-- https://www.electronjs.org/docs/latest/api/environment-variables
env[#env + 1] = { key = "ELECTRON_OZONE_PLATFORM_HINT", value = "auto", comment = "auto selects Wayland if possible, X11 otherwise" }

--- NVIDIA ---
-- This is from Hyprland Wiki. Below will be activated nvidia gpu detected
-- See hyprland wiki https://wiki.hyprland.org/Nvidia/#environment-variables

env[#env + 1] = { key = "LIBVA_DRIVER_NAME", value = "nvidia" }
env[#env + 1] = { key = "__GLX_VENDOR_LIBRARY_NAME", value = "nvidia" }
env[#env + 1] = { key = "NVD_BACKEND", value = "direct" }
env[#env + 1] = { key = "GSK_RENDERER", value = "ngl" }

--- additional ENV's for nvidia. Caution, activate with care ---
-- env[#env + 1] = { key = "GBM_BACKEND", value = "nvidia-drm", enabled = false }

-- env[#env + 1] = { key = "__GL_GSYNC_ALLOWED", value = "1", enabled = false } -- adaptive Vsync
