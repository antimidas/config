--- Hyprland Environment Variables ---
-- https://wiki.hyprland.org/Configuring/Environment-variables/#hyprland-environment-variables
-- env[#env + 1] = { key = "HYPRLAND_TRACE", value = "1", enabled = false } -- Enables more verbose logging.
-- env[#env + 1] = { key = "HYPRLAND_NO_RT", value = "1", enabled = false } -- Disables realtime priority setting by Hyprland.
-- env[#env + 1] = { key = "HYPRLAND_NO_SD_NOTIFY", value = "1", enabled = false } -- If systemd, disables the 'sd_notify' calls.
-- env[#env + 1] = { key = "HYPRLAND_NO_SD_VARS", value = "1", enabled = false } -- Disables management of variables in systemd and dbus activation environments.

return env