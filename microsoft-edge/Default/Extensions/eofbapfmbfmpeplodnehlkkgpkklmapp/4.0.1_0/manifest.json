{
   "action": {
      "default_icon": "icons/icon19.png",
      "default_title": "Open current tab in Polypane (Alt + P)"
   },
   "background": {
      "service_worker": "src/open.js"
   },
   "browser_specific_settings": {
      "gecko": {
         "data_collection_permissions": {
            "required": [ "none" ]
         },
         "id": "{b4d2e20e-7b82-4e89-a591-fd2f7a7abd98}",
         "strict_min_version": "128.0"
      }
   },
   "commands": {
      "open-in-polypane": {
         "description": "Open current tab in Polypane",
         "suggested_key": {
            "default": "Alt+P"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "src/content.js" ],
      "matches": [ "http://*/*", "https://*/*" ]
   } ],
   "description": "Open the current page or links in Polypane, the developer tool for responsive web development and design.",
   "homepage_url": "https://polypane.app",
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Polypane helper",
   "options_ui": {
      "open_in_tab": true,
      "page": "src/options.html"
   },
   "permissions": [ "activeTab", "tabs", "contextMenus", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.0.1",
   "web_accessible_resources": [ {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "icons/icon16.png", "icons/icon48.png" ]
   } ]
}
